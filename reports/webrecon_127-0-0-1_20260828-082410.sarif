{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "WebRecon",
          "informationUri": "https://example.local/webrecon",
          "version": "0.1.0",
          "rules": [
            {
              "id": "FILE",
              "name": "Sensitive file exposed: /.env",
              "shortDescription": {
                "text": "Sensitive file exposed: /.env"
              },
              "fullDescription": {
                "text": "The path /.env is publicly reachable and returned HTTP 200."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/538.html",
              "properties": {
                "security-severity": "7.5",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-538"
              }
            },
            {
              "id": "SEC-HEADERS",
              "name": "Missing Content-Security-Policy",
              "shortDescription": {
                "text": "Missing Content-Security-Policy"
              },
              "fullDescription": {
                "text": "The response is missing the 'content-security-policy' header."
              },
              "helpUri": "https://owasp.org/www-project-secure-headers/",
              "properties": {
                "security-severity": "4.0",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-693"
              }
            },
            {
              "id": "COOKIE",
              "name": "Cookie 'SESSIONID' missing flags: HttpOnly, SameSite",
              "shortDescription": {
                "text": "Cookie 'SESSIONID' missing flags: HttpOnly, SameSite"
              },
              "fullDescription": {
                "text": "Set-Cookie for 'SESSIONID' lacks: HttpOnly, SameSite."
              },
              "helpUri": "https://owasp.org/www-community/controls/SecureCookieAttribute",
              "properties": {
                "security-severity": "3.5",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-1004"
              }
            },
            {
              "id": "DIRLIST",
              "name": "Directory listing enabled: /uploads/",
              "shortDescription": {
                "text": "Directory listing enabled: /uploads/"
              },
              "fullDescription": {
                "text": "The directory /uploads/ returns an auto-generated file index."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/548.html",
              "properties": {
                "security-severity": "5.3",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-548"
              }
            },
            {
              "id": "INFO",
              "name": "Software version disclosed in 'Server' header",
              "shortDescription": {
                "text": "Software version disclosed in 'Server' header"
              },
              "fullDescription": {
                "text": "The 'Server' header reveals a version: BaseHTTP/0.6 Python/3.11.9, VulnServer/1.2.3."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html",
              "properties": {
                "security-severity": "0.0",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-200"
              }
            },
            {
              "id": "JWT",
              "name": "JWT accepts 'alg: none' (unsigned token)",
              "shortDescription": {
                "text": "JWT accepts 'alg: none' (unsigned token)"
              },
              "fullDescription": {
                "text": "A JWT uses the 'none' algorithm, meaning it is unsigned and can be forged."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html",
              "properties": {
                "security-severity": "8.1",
                "owasp": "A02:2021 - Cryptographic Failures",
                "cwe": "CWE-347"
              }
            },
            {
              "id": "CSRF",
              "name": "POST form without anti-CSRF token",
              "shortDescription": {
                "text": "POST form without anti-CSRF token"
              },
              "fullDescription": {
                "text": "A state-changing form has no hidden CSRF token field."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/352.html",
              "properties": {
                "security-severity": "5.4",
                "owasp": "A01:2021 - Broken Access Control",
                "cwe": "CWE-352"
              }
            },
            {
              "id": "XSS",
              "name": "Reflected XSS in 'q'",
              "shortDescription": {
                "text": "Reflected XSS in 'q'"
              },
              "fullDescription": {
                "text": "Input in 'q' is reflected into the HTML response without encoding."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "properties": {
                "security-severity": "6.1",
                "owasp": "A03:2021 - Injection",
                "cwe": "CWE-79"
              }
            },
            {
              "id": "SQLI",
              "name": "SQL injection (error-based) in 'id'",
              "shortDescription": {
                "text": "SQL injection (error-based) in 'id'"
              },
              "fullDescription": {
                "text": "Injecting into 'id' produced a database error, indicating unsanitised input reaches an SQL query."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": {
                "security-severity": "9.8",
                "owasp": "A03:2021 - Injection",
                "cwe": "CWE-89"
              }
            },
            {
              "id": "SSTI",
              "name": "Server-side template injection in 'name'",
              "shortDescription": {
                "text": "Server-side template injection in 'name'"
              },
              "fullDescription": {
                "text": "Input in 'name' is evaluated by a server-side template engine (7*7 rendered as 49)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1336.html",
              "properties": {
                "security-severity": "9.8",
                "owasp": "A03:2021 - Injection",
                "cwe": "CWE-1336"
              }
            },
            {
              "id": "SSRF",
              "name": "Server-side request forgery in 'url'",
              "shortDescription": {
                "text": "Server-side request forgery in 'url'"
              },
              "fullDescription": {
                "text": "The 'url' parameter made the server fetch an internal URL; the response contained internal-only content."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "properties": {
                "security-severity": "8.6",
                "owasp": "A10:2021 - Server-Side Request Forgery",
                "cwe": "CWE-918"
              }
            },
            {
              "id": "IDOR",
              "name": "Possible IDOR on 'id'",
              "shortDescription": {
                "text": "Possible IDOR on 'id'"
              },
              "fullDescription": {
                "text": "Changing 'id' from 1 to 2 returned a different valid resource with no visible access-control barrier."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/639.html",
              "properties": {
                "security-severity": "6.5",
                "owasp": "A01:2021 - Broken Access Control",
                "cwe": "CWE-639"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SQLI",
          "level": "error",
          "message": {
            "text": "SQL injection (error-based) in 'id' \u2014 Full read/modify access to the database; often leads to full system compromise. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:8099/item?id=1"
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "confidence": "CONFIRMED",
            "evidence": "payload=\"'\"; db-error marker='you have an error in your sql syntax'",
            "poc": "curl -i 'http://127.0.0.1:8099/item?id=%27'",
            "remediation": "Use parameterised queries / prepared statements; never concatenate user input into SQL."
          }
        },
        {
          "ruleId": "SSTI",
          "level": "error",
          "message": {
            "text": "Server-side template injection in 'name' \u2014 Template injection commonly escalates to remote code execution on the server. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:8099/render?name=guest"
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "confidence": "CONFIRMED",
            "evidence": "payload='${7*7}' produced '49' in output",
            "poc": "curl -i 'http://127.0.0.1:8099/render?name=%24%7B7%2A7%7D'",
            "remediation": "Never render user input as a template; use a sandboxed engine and pass data as context variables only."
          }
        },
        {
          "ruleId": "FILE",
          "level": "error",
          "message": {
