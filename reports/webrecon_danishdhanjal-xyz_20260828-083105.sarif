{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "WebRecon",
          "informationUri": "https://example.local/webrecon",
          "version": "0.1.0",
          "rules": [
            {
              "id": "SEC-HEADERS",
              "name": "Missing Content-Security-Policy",
              "shortDescription": {
                "text": "Missing Content-Security-Policy"
              },
              "fullDescription": {
                "text": "The response is missing the 'content-security-policy' header."
              },
              "helpUri": "https://owasp.org/www-project-secure-headers/",
              "properties": {
                "security-severity": "4.0",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-693"
              }
            },
            {
              "id": "CORS",
              "name": "Wildcard CORS policy (Access-Control-Allow-Origin: *)",
              "shortDescription": {
                "text": "Wildcard CORS policy (Access-Control-Allow-Origin: *)"
              },
              "fullDescription": {
                "text": "The server allows any origin to read responses."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/942.html",
              "properties": {
                "security-severity": "3.7",
                "owasp": "A05:2021 - Security Misconfiguration",
                "cwe": "CWE-942"
              }
            },
            {
              "id": "CSRF",
              "name": "POST form without anti-CSRF token",
              "shortDescription": {
                "text": "POST form without anti-CSRF token"
              },
              "fullDescription": {
                "text": "A state-changing form has no hidden CSRF token field."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/352.html",
              "properties": {
                "security-severity": "5.4",
                "owasp": "A01:2021 - Broken Access Control",
                "cwe": "CWE-352"
              }
            },
            {
              "id": "XSS",
              "name": "Reflected XSS in 'email'",
              "shortDescription": {
                "text": "Reflected XSS in 'email'"
              },
              "fullDescription": {
                "text": "Input in 'email' is reflected into the HTML response without encoding."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "properties": {
                "security-severity": "6.1",
                "owasp": "A03:2021 - Injection",
                "cwe": "CWE-79"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "XSS",
          "level": "error",
          "message": {
            "text": "Reflected XSS in 'email' \u2014 An attacker can run arbitrary JavaScript in the victim's browser (session theft, defacement). [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://formspree.io/f/maqdyyww"
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "confidence": "CONFIRMED",
            "evidence": "payload='<img src=x onerror=wr9xzq>' reflected unencoded",
            "poc": "curl -i -X POST 'https://formspree.io/f/maqdyyww' --data '_next=#&name=test&email=<img src=x onerror=wr9xzq>&message=test'",
            "remediation": "Context-aware output encoding; validate input; add a Content-Security-Policy."
          }
        },
        {
          "ruleId": "SEC-HEADERS",
          "level": "warning",
          "message": {
            "text": "Missing Content-Security-Policy \u2014 Without CSP, injected scripts run freely, worsening XSS impact. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "confidence": "CONFIRMED",
            "evidence": "Response headers: access-control-allow-origin, age, cache-control, content-disposition, content-encoding, content-type, date, etag, last-modified, server, strict-transport-security, transfer-encodin",
            "poc": "",
            "remediation": "Add a restrictive Content-Security-Policy header."
          }
        },
        {
          "ruleId": "CSRF",
          "level": "warning",
          "message": {
            "text": "POST form without anti-CSRF token \u2014 An attacker page can submit this form on behalf of a logged-in victim. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://formspree.io/f/maqdyyww"
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "confidence": "CONFIRMED",
            "evidence": "fields: _next, name, email, message",
            "poc": "",
            "remediation": "Add a per-session/per-request CSRF token and verify it server-side; use SameSite cookies."
          }
        },
        {
          "ruleId": "SEC-HEADERS",
          "level": "note",
          "message": {
            "text": "Missing X-Frame-Options \u2014 The page can be framed, enabling clickjacking. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "confidence": "CONFIRMED",
            "evidence": "Response headers: access-control-allow-origin, age, cache-control, content-disposition, content-encoding, content-type, date, etag, last-modified, server, strict-transport-security, transfer-encodin",
            "poc": "",
            "remediation": "Add 'X-Frame-Options: DENY' or a CSP frame-ancestors directive."
          }
        },
        {
          "ruleId": "SEC-HEADERS",
          "level": "note",
          "message": {
            "text": "Missing X-Content-Type-Options \u2014 Browsers may MIME-sniff responses, enabling some attacks. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "confidence": "CONFIRMED",
            "evidence": "Response headers: access-control-allow-origin, age, cache-control, content-disposition, content-encoding, content-type, date, etag, last-modified, server, strict-transport-security, transfer-encodin",
            "poc": "",
            "remediation": "Add 'X-Content-Type-Options: nosniff'."
          }
        },
        {
          "ruleId": "SEC-HEADERS",
          "level": "note",
          "message": {
            "text": "Missing Referrer-Policy \u2014 Full URLs may leak to third parties via the Referer header. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "confidence": "CONFIRMED",
            "evidence": "Response headers: access-control-allow-origin, age, cache-control, content-disposition, content-encoding, content-type, date, etag, last-modified, server, strict-transport-security, transfer-encodin",
            "poc": "",
            "remediation": "Add 'Referrer-Policy: strict-origin-when-cross-origin'."
          }
        },
        {
          "ruleId": "CORS",
          "level": "note",
          "message": {
            "text": "Wildcard CORS policy (Access-Control-Allow-Origin: *) \u2014 Any website can read responses (higher risk if the endpoint returns sensitive data). [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "confidence": "CONFIRMED",
            "evidence": "Access-Control-Allow-Origin: *",
            "poc": "",
            "remediation": "Restrict Access-Control-Allow-Origin to a trusted allowlist of origins."
          }
        },
        {
          "ruleId": "SEC-HEADERS",
          "level": "note",
          "message": {
            "text": "Missing Permissions-Policy \u2014 Powerful browser features are not explicitly restricted. [confidence: CONFIRMED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://danishdhanjal.xyz/"
                }
              }
            }
          ],
          "properties": {
            "severity": "INFO",
            "confidence": "CONFIRMED",
            "evidence": "Response headers: access-control-allow-origin, age, cache-control, content-disposition, content-encoding, content-type, date, etag, last-modified, server, strict-transport-security, transfer-encodin",
            "poc": "",
            "remediation": "Add a Permissions-Policy header disabling unused features."
          }
        }
      ]
    }
  ]
}