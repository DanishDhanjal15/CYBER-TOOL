<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WebRecon Report — {{ result.target }}</title>
<style>
  :root{
    --bg:#0f1420; --card:#171d2b; --muted:#8a93a6; --text:#e6e9f0; --line:#26304a;
    --crit:#ff4d5e; --high:#ff8a3d; --med:#ffcc45; --low:#4dd0e1; --info:#7f9cf5;
    --ok:#38d39f;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);
    font:15px/1.55 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}
  .wrap{max-width:1040px;margin:0 auto;padding:32px 20px 80px}
  header h1{margin:0 0 4px;font-size:26px}
  header .sub{color:var(--muted);font-size:14px}
  .banner{background:#2a1c1c;border:1px solid #5a2a2a;color:#ffb3b3;
    padding:10px 14px;border-radius:8px;margin:16px 0;font-size:13px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:14px;margin:20px 0}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:12px;
    padding:16px}
  .stat .k{color:var(--muted);font-size:12px;text-transform:uppercase;
    letter-spacing:.05em}
  .stat .v{font-size:24px;font-weight:700;margin-top:4px}
  .score{display:flex;align-items:center;gap:16px;background:var(--card);
    border:1px solid var(--line);border-radius:12px;padding:20px;margin:8px 0}
  .gauge{--pct:{{ score }};width:96px;height:96px;border-radius:50%;flex:0 0 auto;
    background:conic-gradient(var(--accent) calc(var(--pct)*1%),#2a3350 0);
    display:grid;place-items:center;position:relative}
  .gauge::before{content:"";position:absolute;inset:10px;background:var(--card);
    border-radius:50%}
  .gauge span{position:relative;font-size:22px;font-weight:800}
  .sevrow{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 22px}
  .pill{padding:6px 12px;border-radius:999px;font-size:13px;font-weight:700;
    border:1px solid var(--line)}
  .CRITICAL{color:var(--crit)} .HIGH{color:var(--high)} .MEDIUM{color:var(--med)}
  .LOW{color:var(--low)} .INFO{color:var(--info)}
  .b-CRITICAL{border-left:4px solid var(--crit)}
  .b-HIGH{border-left:4px solid var(--high)}
  .b-MEDIUM{border-left:4px solid var(--med)}
  .b-LOW{border-left:4px solid var(--low)}
  .b-INFO{border-left:4px solid var(--info)}
  h2{margin:34px 0 12px;font-size:19px;border-bottom:1px solid var(--line);
    padding-bottom:8px}
  .finding{background:var(--card);border:1px solid var(--line);border-radius:12px;
    padding:16px 18px;margin:12px 0}
  .finding h3{margin:0 0 6px;font-size:16px;display:flex;gap:10px;
    align-items:center}
  .tag{font-size:11px;font-weight:800;padding:3px 8px;border-radius:6px;
    background:#0d1220;border:1px solid var(--line)}
  .finding .loc{color:var(--muted);font-size:13px;word-break:break-all}
  .kv{margin-top:10px;font-size:14px}
  .kv b{color:var(--muted);font-weight:600;display:inline-block;min-width:104px;
    vertical-align:top}
  .ev{background:#0c1018;border:1px solid var(--line);border-radius:8px;
    padding:8px 10px;margin-top:4px;font:12.5px/1.5 ui-monospace,Menlo,Consolas,
    monospace;white-space:pre-wrap;word-break:break-all;color:#c9d4ee}
  table.recon{width:100%;border-collapse:collapse;font-size:13.5px}
  table.recon td{border:1px solid var(--line);padding:6px 10px;vertical-align:top}
  table.recon td:first-child{color:var(--muted);width:160px}
  footer{margin-top:40px;color:var(--muted);font-size:12px;text-align:center}
  code{background:#0c1018;padding:1px 5px;border-radius:4px}
  .conf{font-size:11px;font-weight:800;padding:2px 7px;border-radius:5px;
    background:#0d1220;border:1px solid var(--line);color:var(--low)}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>WebRecon Security Report</h1>
    <div class="sub">Target: <b>{{ result.target }}</b> &nbsp;·&nbsp;
      {{ result.started_at }} &nbsp;·&nbsp; {{ "%.1f"|format(result.duration_seconds) }}s</div>
  </header>

  <div class="banner">Authorized testing only. This report was generated by an
    automated scanner and may contain false positives; verify each finding
    before acting.</div>

  {% set accent = 'var(--crit)' if score>=70 else ('var(--high)' if score>=40 else ('var(--med)' if score>=15 else 'var(--ok)')) %}
  <div class="score">
    <div class="gauge" style="--accent:{{ accent }}"><span>{{ score }}</span></div>
    <div>
      <div style="font-size:13px;color:var(--muted)">OVERALL RISK</div>
      <div style="font-size:22px;font-weight:800">{{ band }}</div>
      <div style="color:var(--muted);font-size:13px">{{ findings|length }} total finding(s)</div>
    </div>
  </div>

  <div class="sevrow">
    {% for s in severities %}
      <span class="pill {{ s }}">{{ s }}: {{ counts[s] }}</span>
    {% endfor %}
  </div>

  <div class="grid">
    <div class="stat"><div class="k">URLs crawled</div><div class="v">{{ stats.get('urls_crawled',0) }}</div></div>
    <div class="stat"><div class="k">Forms</div><div class="v">{{ stats.get('forms_found',0) }}</div></div>
    <div class="stat"><div class="k">Parameters</div><div class="v">{{ stats.get('params_found',0) }}</div></div>
    <div class="stat"><div class="k">Requests sent</div><div class="v">{{ stats.get('requests_sent',0) }}</div></div>
    <div class="stat"><div class="k">Checks run</div><div class="v">{{ stats.get('checks_run',0) }}</div></div>
  </div>

  <h2>Findings</h2>
  {% if not findings %}
    <p style="color:var(--ok)">No issues were detected by the automated checks.</p>
  {% endif %}
  {% for f in findings %}
  <div class="finding b-{{ f.severity }}">
    <h3>
      <span class="tag {{ f.severity }}">{{ f.severity }}</span>
      {{ f.title }}
    </h3>
    <div class="loc">{{ f.location or 'n/a' }}</div>
    <div class="kv"><b>OWASP</b> {{ f.owasp or '-' }}{% if f.cwe %} &nbsp;·&nbsp; {{ f.cwe }}{% endif %}{% if f.cvss %} &nbsp;·&nbsp; CVSS ~{{ f.cvss }}{% endif %}{% if f.confidence %} &nbsp;·&nbsp; <span class="conf">{{ f.confidence }}</span>{% endif %}</div>
    <div class="kv"><b>Description</b> {{ f.description }}</div>
    {% if f.evidence %}<div class="kv"><b>Evidence</b><div class="ev">{{ f.evidence }}</div></div>{% endif %}
    <div class="kv"><b>Impact</b> {{ f.impact }}</div>
    <div class="kv"><b>Remediation</b> {{ f.remediation }}</div>
    {% if f.poc %}<div class="kv"><b>Proof / PoC</b><div class="ev">{{ f.poc }}</div></div>{% endif %}
    {% if f.references %}<div class="kv"><b>References</b>
      {% for r in f.references %}<a href="{{ r }}" style="color:var(--low)">{{ r }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
    </div>{% endif %}
  </div>
  {% endfor %}

  <h2>Reconnaissance</h2>
  <table class="recon">
    <tr><td>IP address(es)</td><td>{{ recon.get('dns',{}).get('ip_addresses',[])|join(', ') or '-' }}</td></tr>
    {% set ports = recon.get('ports',{}).get('open_ports',{}) %}
    <tr><td>Open ports</td><td>
      {% if ports %}{% for p,info in ports.items() %}<code>{{ p }}/{{ info.service }}</code> {% endfor %}{% else %}none detected{% endif %}
    </td></tr>
    {% set tls = recon.get('tls',{}) %}
    <tr><td>TLS</td><td>
      {% if tls.get('protocol') %}{{ tls.get('protocol') }} · issuer: {{ tls.get('issuer','?') }} · expires: {{ tls.get('not_after','?') }}{% else %}{{ tls.get('note', tls.get('error','n/a')) }}{% endif %}
    </td></tr>
    {% set tech = recon.get('fingerprint',{}).get('technologies',{}) %}
    <tr><td>Technology</td><td>
      {% if tech %}{% for k,v in tech.items() %}<b>{{ k }}:</b> {{ v }}<br>{% endfor %}{% else %}-{% endif %}
    </td></tr>
    <tr><td>Exposed files</td><td>
      {% set ef = recon.get('files',{}).get('exposed_files',[]) %}
      {% if ef %}{% for p in ef %}<code>/{{ p }}</code> {% endfor %}{% else %}none detected{% endif %}
    </td></tr>
  </table>

  <footer>Generated by WebRecon v0.1 · For authorized security assessment only.</footer>
</div>
</body>
</html>
